#!/bin/sh
# lspec commit-msg hook: the gates that need the candidate commit's subject,
# run where the subject exists.
#   - review gate: blocks a commit whose candidate tree carries an obligation
#     already outstanding at HEAD, unless the subject is a recorded `review:`
#     naming the claim or a `seed:` boundary discarding the dependent file's
#     lineage. Unavailable history blocks (recover: fetch sufficient history,
#     or record a review with `lspec review`).
#   - vocabulary gate: the subject's type must come from main's staged
#     data-commit-types declaration; legacy documents without one are
#     reported ("commit vocabulary not enforced"), never defaulted.
# Structural checks ran in pre-commit. Install:
#   ln -sf ../../hooks/commit-msg .git/hooks/commit-msg
set -e
root=$(git rev-parse --show-toplevel)
main=${LSPEC_MAIN:-live-spec.html}
# The message file is handed to the hook relative to the repo root — pin the
# path absolute; git may likewise hand a relative GIT_DIR/GIT_INDEX_FILE.
case "$1" in
  /*) msg="$1" ;;
  *)  msg="$root/$1" ;;
esac
export GIT_DIR="$root/.git" GIT_INDEX_FILE="$root/.git/index"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
tool="$tmp/lspec.py"
git -C "$root" show :lspec.py > "$tool" 2>/dev/null || tool="$root/lspec.py"
cd "$root"
if ! python3 "$tool" check --staged --commit-msg "$msg" "$main"; then
  echo "commit-msg: lspec gates failed; red blocks the commit (dl-hook)" >&2
  exit 1
fi
