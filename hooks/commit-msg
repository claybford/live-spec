#!/bin/sh
# Part of lspec (github.com/claybford/live-spec). Copyright (c) 2026 Clayton Ford.
# MIT License; the full notice heads lspec.py.
# lspec commit-msg: confirm the final message carries the reconciled subject
# and Reconciled: trailers, and recheck the receipt after message preparation.
# Install:
#   ln -sf ../../hooks/commit-msg .git/hooks/commit-msg
set -e
root=$(git rev-parse --show-toplevel)
case "$1" in
  /*) msg="$1" ;;
  *)  msg="$root/$1" ;;
esac
export GIT_DIR="$(git rev-parse --absolute-git-dir)"
export GIT_INDEX_FILE="$(git rev-parse --path-format=absolute --git-path index)"
export GIT_OPTIONAL_LOCKS=0
tmp=$(mktemp -d "$GIT_DIR/lspec-hook.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
tool="$tmp/lspec.py"
git -C "$root" show :lspec.py > "$tool" 2>/dev/null || tool="$root/lspec.py"
cd "$root"
python3 "$tool" hook commit-msg "$msg"
