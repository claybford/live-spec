#!/bin/sh
# lspec pre-commit hook: run `lspec check` against the *staged* tree.
# Red blocks the commit (dl-hook). Install:  ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
# Hooks do not clone; run the same check in CI.
set -e
root=$(git rev-parse --show-toplevel)
main=${LSPEC_MAIN:-live-spec.html}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
cd "$tmp"
# Stamps and diffs speak about the staged tree, not the working tree. Git may
# hand hooks a *relative* GIT_DIR/GIT_INDEX_FILE — pin both absolute before cd.
export GIT_DIR="$root/.git" GIT_WORK_TREE="$tmp" GIT_INDEX_FILE="$root/.git/index" \
       LSPEC_BASIS=staged
# Gate with the checker being committed, falling back to the working-tree one
# (e.g. the commit that first adds lspec.py to a repo that already has specs).
tool="$tmp/lspec.py"
[ -f "$tool" ] || tool="$root/lspec.py"
if ! python3 "$tool" check "$main"; then
  echo "pre-commit: lspec check failed; red blocks the commit (dl-hook)" >&2
  exit 1
fi
